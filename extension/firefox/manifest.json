{
  "manifest_version": 3,
  "name": "Send to Clip2Pod",
  "version": "0.3.0",
  "description": "Send the page you are reading to Clip2Pod — narrated as an article, or its audio ripped.",
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:4737/*"],
  "background": { "scripts": ["background.js"] },
  "browser_specific_settings": {
    "gecko": {
      "id": "clip2pod@flocktimusprime",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Send to Clip2Pod — click to send; right-click the page to force narrate / rip",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "theme_icons": [
      { "light": "icons/icon16-light.png", "dark": "icons/icon16.png", "size": 16 },
      { "light": "icons/icon32-light.png", "dark": "icons/icon32.png", "size": 32 }
    ]
  }
}
